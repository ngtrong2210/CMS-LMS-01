{
  "ConnectionStrings": {
    "BootstrapConnection": "",
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "LearnHub.Api",
    "Audience": "LearnHub.Web",
    "Key": "LOCAL-DEVELOPMENT-KEY-CHANGE-ME-AT-LEAST-32-CHARS",
    "AccessTokenMinutes": 60
  },
  "Database": {
    "AutoInitialize": false,
    "ScriptsPath": "../../database"
  },
  "VideoUpload": {
    "RootFolder": "uploads/videos",
    "MaxFileSizeMB": 500
  },
  "Storage": {
    "CachePath": "storage/cache",
    "TempPath": "storage/temp",
    "ExportPath": "storage/exports",
    "ProcessingPath": "storage/processing",
    "LogPath": "logs",
    "CacheRetentionHours": 24,
    "TempRetentionHours": 24,
    "ExportRetentionHours": 24,
    "ProcessingRetentionHours": 24,
    "CleanupIntervalHours": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
