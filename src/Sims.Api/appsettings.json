{
  "ConnectionStrings": {
    "BootstrapConnection": "",
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "LearnHub.Api",
    "Audience": "LearnHub.Web",
    "Key": "LOCAL-DEVELOPMENT-KEY-CHANGE-ME-AT-LEAST-32-CHARS",
    "AccessTokenMinutes": 60
  },
  "Database": {
    "AutoInitialize": false,
    "ScriptsPath": "../../database"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174"
    ]
  },
  "Media": {
    "VideoPath": "Media/Video",
    "ImagePath": "Media/Image",
    "FilePath": "Media/File",
    "ThumbnailPath": "Media/Thumbnail",
    "AudioPath": "Media/Audio",
    "MaxVideoFileSizeMB": 500,
    "MaxLearningFileSizeMB": 200
  },
  "Storage": {
    "CachePath": "storage/cache",
    "TempPath": "storage/temp",
    "ExportPath": "storage/exports",
    "ProcessingPath": "storage/processing",
    "LogPath": "logs",
    "CacheRetentionHours": 24,
    "TempRetentionHours": 24,
    "ExportRetentionHours": 24,
    "ProcessingRetentionHours": 24,
    "CleanupIntervalHours": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
